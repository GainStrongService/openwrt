CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_gainstrong_oolite-v1.0=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y

# CONFIG_IPV6 is not set

CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="Oolite-V1.0"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y

CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-sleep=y
CONFIG_PACKAGE_coreutils-dd=y

# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set

# CONFIG_PACKAGE_urandom-seed is not set
# CONFIG_PACKAGE_urngd is not set

CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_usbutils=y
