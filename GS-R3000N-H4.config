# Reproducible configuration seed for the public GS-R3000N-H4 SDK.
#
# Keep this file limited to the target selection and packages that are
# intentionally part of the customer reference image. OpenWrt's defconfig
# step resolves the base system and package dependencies; the generated
# .config is a build-time file and is not a source of truth.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_gainstrong_gs-r3000n-h4=y

# Generate squashfs reference images and a separate RAM-only image.
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Keep standard image metadata and the revision in generated filenames.
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="GainStrong"
CONFIG_VERSION_MANUFACTURER="GainStrong"
CONFIG_VERSION_PRODUCT="GS-R3000N-H4"
CONFIG_VERSION_NUMBER="25.12.5"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y

# Direct package choices. Dependencies and standard OpenWrt base packages are
# selected automatically by make defconfig.
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_en=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_kmod-mtd-rw=y
