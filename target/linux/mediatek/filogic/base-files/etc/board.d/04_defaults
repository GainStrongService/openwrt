. /lib/functions/uci-defaults.sh

board=$(board_name)

board_config_update

case $board in
gainstrong,oolite-mt7987a)
	ucidef_set_country CN
	ucidef_set_wireless 2g "Oolite-MT7987A-2.4G" "none"
	ucidef_set_wireless 5g "Oolite-MT7987A-5G" "none"
	;;
openwrt,one)
	ucidef_set_wireless_mac_count 2g 7
	ucidef_set_wireless_mac_count 5g 7
	;;
esac

board_config_flush

exit 0
